APP_DATA_PATH=storage/data.json
APP_CACHE_PATH=storage/cache
NEWS_RSS_URL=https://www.mining.com/feed/
MINING_NEWS_RSS_URL=https://news.google.com/rss/search?q=mining+industry+critical+minerals&hl=en-US&gl=US&ceid=US:en
POLICY_RSS_URL=https://news.google.com/rss/search?q=critical+minerals+policy&hl=en-US&gl=US&ceid=US:en
PRICE_SYMBOLS=HG=F,GC=F,SI=F
REQUEST_TIMEOUT=12
# Official policy page crawling: hybrid tries requests/BeautifulSoup first,
# then the optional Crawl4AI browser adapter when the page is blocked or sparse.
POLICY_CRAWLER_ENGINE=hybrid
POLICY_CRAWL_MAX_PAGES=4
POLICY_CRAWL_MAX_DEPTH=1
POLICY_CRAWL_TIMEOUT=8
POLICY_CRAWL_MIN_TEXT=120
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
